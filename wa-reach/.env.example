# Copy to .env and fill in. Generate secrets with:  openssl rand -base64 36

# Shared by OpenWA (as API_MASTER_KEY) and WA Reach. At least 32 characters.
# OpenWA seeds it as the admin key on FIRST boot only; changing it later means
# creating a new key in the OpenWA dashboard and putting that here.
OPENWA_API_KEY=

# Password for the WA Reach dashboard.
ADMIN_PASSWORD=

# Public https URL of WA Reach (e.g. https://reach.yourdomain.com).
# Enables click-tracked short links. Leave empty to disable click tracking.
PUBLIC_URL=

# Optional: enables the REST API with the X-API-Key header (min 16 chars),
# e.g. to add contacts from a website form, CRM, Zapier or n8n.
APP_API_KEY=

# Defaults for new installs (both editable later in Settings).
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN

# Optional overrides
# OPENWA_IMAGE=docker.io/rmyndharis/openwa:0.23   # or ghcr.io/rmyndharis/openwa:0.23
# OPENWA_ENGINE=whatsapp-web.js     # or baileys (lighter, higher ban risk)
# OPENWA_MEM_LIMIT=2g
# WA_REACH_PORT=3000
# OPENWA_PORT=2785

# ---- Running without Docker (npm start) ----
# OPENWA_URL=http://localhost:2785
# WEBHOOK_URL=http://localhost:3000/webhooks/openwa   # URL OpenWA can reach
# DATA_DIR=./data
# PORT=3000
# APP_SECRET=                        # cookie signing; generated into DATA_DIR if unset
# OPENWA_WEBHOOK_SECRET=             # generated into DATA_DIR if unset
# COOKIE_SECURE=true                 # defaults to true when PUBLIC_URL is https
