# Copy to .env and fill in. Generate secrets with:  openssl rand -base64 36

# ---- Your platform-admin login (created on first start) ----
ADMIN_EMAIL=you@yourbrand.com
ADMIN_PASSWORD=

# Shared by OpenWA (as API_MASTER_KEY) and WA Reach. At least 32 characters.
# OpenWA seeds it as its admin key on FIRST boot only; changing it later means
# creating a new key in the OpenWA dashboard and putting that here.
OPENWA_API_KEY=

# ---- Going live on your server with HTTPS (docker-compose.prod.yml) ----
# DOMAIN=app.yourbrand.com
# PUBLIC_URL=https://app.yourbrand.com     # enables click tracking + secure cookies

# Defaults for new businesses' time zone and phone country (each business can change them).
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_COUNTRY=IN

# Optional overrides
# OPENWA_IMAGE=docker.io/rmyndharis/openwa:0.23   # or ghcr.io/rmyndharis/openwa:0.23
# OPENWA_ENGINE=whatsapp-web.js     # or baileys (lighter, higher ban risk)
# OPENWA_MEM_LIMIT=2g               # ~300-500 MB per connected number on whatsapp-web.js
# WA_REACH_PORT=3000
# WA_REACH_BIND=127.0.0.1           # default: only this machine (and Caddy) can reach port 3000
# OPENWA_PORT=2785

# ---- Running without Docker (npm start) ----
# OPENWA_URL=http://localhost:2785
# WEBHOOK_URL=http://localhost:3000/webhooks/openwa   # URL OpenWA can reach
# DATA_DIR=./data
# PORT=3000
# APP_SECRET=                        # cookie signing; generated into DATA_DIR if unset
# OPENWA_WEBHOOK_SECRET=             # generated into DATA_DIR if unset
