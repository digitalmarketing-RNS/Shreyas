# ---------------------------------------------------------------------------
# RNS Voice Agent — configuration
#
# Rename this file to  .env  (exactly, no .example) and fill in the values.
# The app reads .env automatically. If your host also has an environment
# variables panel, values set there win over this file.
#
# Replace the WHOLE value after each "=". Do not paste next to REPLACE_ME.
# Never commit this file once it has real values in it.
# ---------------------------------------------------------------------------

# --- xAI -------------------------------------------------------------------
# MUST begin with "xai-". Copy the entire key including that prefix.
# A key that looks like a UUID is the key *ID*, not the key.
XAI_API_KEY=xai-REPLACE_ME

# The voice agent from the xAI console. Its prompt, voice and language are
# used exactly as configured there; this app does not override them.
XAI_AGENT_ID=agent_CvgfdQIkeaZ1IGqg

# --- Plivo -----------------------------------------------------------------
PLIVO_AUTH_ID=REPLACE_ME
PLIVO_AUTH_TOKEN=REPLACE_ME
PLIVO_PHONE_NUMBER=+918031705594

# --- Deployment ------------------------------------------------------------
# Public https address of this app, with NO trailing slash.
# Plivo calls back to it, so it must be reachable from the internet.
PUBLIC_BASE_URL=https://your-domain.com

# Dashboard password. Choose something long — this protects the ability to
# place calls on your account.
DASHBOARD_PASSWORD=REPLACE_ME

# PORT is normally injected by the host. Leave it commented out unless you are
# running locally; setting it wrongly stops the host reaching the app.
# PORT=3000

# --- Agent behaviour -------------------------------------------------------
# Offers the agent a save_call_details function that writes structured fields
# (outcome, appointment time, callback number) onto the call record.
#
# Leave this false if your agent has connectors set up in the xAI console.
# Asked to book an appointment, an agent with a calendar connected will find
# the connector and create the event. Offer it this tool as well and it uses
# this one instead: the booking shows in the dashboard and never reaches your
# calendar, and nothing reports a problem. Turn it on only if the agent has no
# connector that covers the same ground.
#
# The transcript, duration, number and disposition are recorded either way.
AGENT_DETAILS_TOOL=false

# What this server tells the agent about the call. 'facts' passes the dialled
# number and the lead's fields as data; 'off' passes nothing. Neither sends any
# instructions — how the agent behaves comes entirely from its own xAI console
# configuration.
AGENT_BRIEFING=facts

# Composes the opening line while Plivo is still opening the audio stream, so
# it is ready to play the moment the caller can hear anything.
PREWARM_GREETING=true

# Does that work while the phone is still ringing rather than after it is
# answered. Measured against the live agent: opening the session takes ~490 ms
# and composing the opening line ~750 ms, and this moves both off the part the
# caller is awake for. Costs one agent session per number dialled, answered or
# not — with one call at a time that is at most one in flight, closed when the
# ring times out.
PREWARM_ON_DIAL=true

# Offers the agent an end_call function of ours.
#
# Leave this false. Sending ANY tools list on a session REPLACES the tools your
# agent has in the xAI console — connectors included. Measured against the live
# agent, asked to book an appointment: with no tools sent it reached its
# calendar connector on 3 of 3 runs; sending only this one tool it invoked
# nothing at all and booked nothing.
#
# It does not need ours. It has its own end_call, and when it uses that xAI
# closes the session, which this server already treats as the end of the call —
# draining whatever is still playing before releasing the line. Turn this on
# only for an agent that has no end_call of its own.
AGENT_CALL_CONTROL=false

# A number to hand callers to when the agent decides to transfer. Blank means
# no transfer function is offered at all, which is the default — if you never
# want calls handed to a person, leave this exactly as it is. When set, the
# agent chooses whether to transfer, never where to, so a call can only ever
# reach this number.
TRANSFER_NUMBER=

# How long to wait for confirmation that the last words finished playing before
# hanging up regardless. Only reached if the confirmation is lost.
HANGUP_GRACE_MS=8000

# Streams the caller's words to the dashboard while they are still speaking,
# instead of once each sentence finishes. The finished transcript of every
# utterance is recorded either way — this only decides whether it also shows
# up mid-sentence. Off because it sets a field xAI's event docs require but
# its published session schema does not list; turn it on and place one test
# call, and if the transcript still arrives, keep it.
XAI_LIVE_CAPTIONS=false

# --- Dialling behaviour ----------------------------------------------------
MAX_CONCURRENT_CALLS=5
RING_TIMEOUT_SECONDS=30
DEFAULT_COUNTRY_CODE=91
DEFAULT_TIMEZONE=Asia/Kolkata
BRAND_NAME=RNS

# Turn off only if webhooks are rejected because a proxy rewrites the URL.
PLIVO_VALIDATE_SIGNATURE=true
LOG_LEVEL=info
