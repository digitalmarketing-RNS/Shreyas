# ---------------------------------------------------------------------------
# RNS Voice Agent — environment variables
# Copy to .env (or paste into Hostinger's environment variables panel).
# Never commit the real values.
# ---------------------------------------------------------------------------

# --- xAI -------------------------------------------------------------------
# Must start with "xai-". If yours looks like a UUID you copied the key ID from
# the console list instead of the key itself; create a new key and copy the
# secret shown once at creation time.
XAI_API_KEY=xai-REPLACE_ME

# The voice agent you built in the xAI console. Its prompt, voice and language
# are used as-is; this app does not override them.
XAI_AGENT_ID=agent_CvgfdQIkeaZ1IGqg

# --- Plivo -----------------------------------------------------------------
PLIVO_AUTH_ID=REPLACE_ME
PLIVO_AUTH_TOKEN=REPLACE_ME
PLIVO_PHONE_NUMBER=+918031705594

# --- Deployment ------------------------------------------------------------
# The public https address of this app. Plivo calls back to it, so it must be
# reachable from the internet and must be https.
PUBLIC_BASE_URL=https://your-domain.com

# Password for the dashboard. Pick something long. Without it, anyone who finds
# the URL can place calls on your account.
DASHBOARD_PASSWORD=REPLACE_ME

PORT=3000

# --- Dialing behaviour -----------------------------------------------------
MAX_CONCURRENT_CALLS=5
RING_TIMEOUT_SECONDS=30
DEFAULT_COUNTRY_CODE=91
DEFAULT_TIMEZONE=Asia/Kolkata
BRAND_NAME=RNS

# Turn off only if webhooks are rejected because a proxy rewrites the URL.
PLIVO_VALIDATE_SIGNATURE=true
LOG_LEVEL=info
